# ---------------------------------------------------------------
# Classroom Pulse — environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ---------------------------------------------------------------

# Flask secret key — used to sign session cookies.
# Generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database URL (optional).
# Defaults to SQLite at src/instance/database.db.
# For production you can point this at a PostgreSQL instance:
#   DATABASE_URL=postgresql://user:password@host:5432/classroom_pulse
# DATABASE_URL=sqlite:///database.db

# Admin account password seeded on first run (optional).
# Only applied when no users exist in the database.
# Defaults to "changeme123" if not set — change this before deploying.
# ADMIN_PASSWORD=changeme123

# Set to "1" to load demo data on first run (dev/testing only).
# Creates grades, students, and 6 fortnights of ranking entries, plus
# demo accounts (teacher_5a, incharge_5a, coordinator — password: test123).
# NOTE: the variable name is SEED_DEMO_DATA, not SEED.
# SEED_DEMO_DATA=1
